            ax.set_xlabel("Mixture Components")
            ax.set_ylabel("Weights")
            ax.set_ylim(0, vis_child_mix_weights.max().item() * 1.1)
    
    # fig.suptitle(f"Child Category Weights of {struct_upbd['G1']} Shared Mixture Components", fontsize=16)
    fig.tight_layout()
    plt.show()
    



