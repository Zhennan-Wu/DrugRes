    training_x = cat_cell_features(features=feature_dict_per_drug, sample_size=len(resp_per_drug), feature_list=['Missense_Mutation', 'Silent', 'In_Frame_Ins', 'Splice_Site', 'Nonsense_Mutation', 'Frame_Shift_Del', 'Nonstop_Mutation', 'Start_Codon_SNP', 'In_Frame_Del', 'Frame_Shift_Ins'])
    training_y = np.array(resp_per_drug)
    drug_response[drug] = {"cell_line": training_x, "auc": training_y}
    umap = UMAP()
    # Fit and transform the data
    X_train_umap = umap.fit_transform(training_x)
    
    # Plot the results
    plt.figure(figsize=(10, 8))
    scatter = plt.scatter(X_train_umap[:, 0], X_train_umap[:, 1], c=training_y, cmap="Spectral", s=1, alpha=0.6)
    plt.colorbar(scatter, label="Digit Label")
    plt.title("UMAP Encoding for drug {} response".format(drug))
    plt.xlabel("UMAP Dimension 1")
    plt.ylabel("UMAP Dimension 2")
    # Show the plot
    plt.tight_layout()
    plt.savefig(os.path.join(plt_dic, "{}.png".format(drug)))
    plt.close()


